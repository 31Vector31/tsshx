{
  "name": "tsshx",
  "version": "0.1.0",
  "description": "SSH terminal with credential vault, integrated SFTP/FTP file manager and remote directory indexer",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "basic-ftp": "^5.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "electron@44.4.1": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true,
    "node-pty@1.1.0": true
  },
  "build": {
    "appId": "tsshx",
    "productName": "tsshx",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!**/*.map",
      "!**/test/**",
      "!**/docs/**"
    ],
    "asarUnpack": [
      "node_modules/cpu-features/**",
      "node_modules/ssh2/lib/protocol/crypto/build/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "desktop": {
        "entry": {
          "Name": "tsshx",
          "Comment": "SSH terminal with credential vault, SFTP/FTP and directory index"
        }
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
